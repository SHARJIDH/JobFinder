# Copy to .env and fill in. NEVER commit .env. Placeholders only.

APP_ENV=development                 # development | production
# DATA_DIR=./data                   # profile.yaml, search.yaml, SQLite DB, uploads, generated documents
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/jobhunter   # empty -> SQLite in DATA_DIR

# --- Access control (single user) ---
APP_PASSWORD=change-me-to-a-long-random-passphrase
SESSION_SECRET=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-48
COOKIE_SECURE=false                 # true when served over HTTPS (Cloud Run)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI provider (Gemini via Vertex AI, uses Application Default Credentials) ---
LLM_PROVIDER=none                   # gemini | none (none = deterministic mode, no model calls)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL_FAST=gemini-3.1-flash-lite     # scoring, answer drafts, profile extraction
GEMINI_MODEL_QUALITY=gemini-2.5-flash       # resume/cover-letter tailoring
GEMINI_MODEL_SEARCH=gemini-2.5-flash        # web search with Grounding with Google Search
# Estimated USD per 1M tokens — verify against current Vertex AI pricing
PRICE_FAST_INPUT_PER_M=0.25
PRICE_FAST_OUTPUT_PER_M=1.50
PRICE_QUALITY_INPUT_PER_M=0.30
PRICE_QUALITY_OUTPUT_PER_M=2.50
PRICE_GROUNDED_PROMPT_USD=0.035             # per grounded web-search request
LLM_DAILY_CALL_LIMIT=150
LLM_DAILY_BUDGET_USD=1.00

# --- Discovery politeness ---
HTTP_USER_AGENT=AIJobHunter/0.1 (personal job search; contact: you@example.com)
HTTP_MIN_INTERVAL_SECONDS=1.0

# --- Notifications (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                      # e.g. a Gmail App Password, never your account password
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_BASE_URL=http://localhost:3000

# --- Local-only browser assistance (Playwright, headed) ---
BROWSER_AUTOMATION_ENABLED=false
